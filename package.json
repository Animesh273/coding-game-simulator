{
  "name": "ascend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ASCEND — a gamified, AI-mentored placement preparation RPG for engineering students.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.api.json",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.109.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
